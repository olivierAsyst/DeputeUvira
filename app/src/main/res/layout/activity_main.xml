<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollAccueil"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <include layout="@layout/flag_strip" />

                <!-- HERO -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="260dp">

                    <ImageView
                        android:id="@+id/imgHero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0.55"
                        android:background="@color/card_bg"
                        android:contentDescription="@string/photo_depute_desc" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gradient_hero" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:padding="16dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgPortrait"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:background="@color/card_bg"
                                android:contentDescription="@string/photo_depute_desc" />

                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/eyebrow_depute"
                                android:textColor="@color/accent_amber"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.15" />

                            <TextView
                                android:id="@+id/tvNomDepute"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/nom_depute"
                                android:textColor="@color/text_white_100"
                                android:textSize="22sp"
                                android:fontFamily="@font/playfair_display"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/localisation_depute"
                                android:textColor="@color/text_white_50"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <!-- BANNIÈRE CAMPAGNE -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCampagne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_campaign_banner"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/campagne_en_cours"
                                android:textColor="#B307111F"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.15" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal"
                                android:gravity="bottom">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/votez_numero"
                                    android:textColor="#9907111F"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:id="@+id/tvNumeroGeant"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/numero_vote_valeur"
                                    android:textColor="@color/on_amber"
                                    android:textSize="44sp"
                                    android:fontFamily="sans-serif-black" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/circonscription_election"
                                android:textColor="#9907111F"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                        <include layout="@layout/flag_strip" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- SLOGAN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/slogan_depute"
                        android:textColor="@color/text_white_80"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/legende_slogan"
                        android:textColor="@color/text_white_30"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- STATISTIQUES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valeur_mandats"
                            android:textColor="@color/accent_amber"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/label_mandats"
                            android:textColor="@color/text_white_40"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valeur_projets"
                            android:textColor="@color/accent_amber"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/label_projets"
                            android:textColor="@color/text_white_40"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valeur_beneficiaires"
                            android:textColor="@color/accent_amber"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/label_beneficiaires"
                            android:textColor="@color/text_white_40"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </LinearLayout>

                <!-- PROCHAIN ÉVÉNEMENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/titre_prochain_evenement"
                            android:textColor="@color/text_white_50"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/btnVoirAgenda"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_agenda"
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@color/accent_amber" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="48dp"
                                android:background="@drawable/bg_datebox_amber"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">

                                <TextView
                                    android:id="@+id/tvJourEvenement"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/jour_evenement"
                                    android:textColor="@color/accent_amber"
                                    android:textSize="22sp"
                                    android:fontFamily="sans-serif-black" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/mois_evenement"
                                    android:textColor="@color/accent_amber"
                                    android:alpha="0.6"
                                    android:textSize="10sp"
                                    android:fontFamily="sans-serif-black" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/titre_evenement"
                                    android:textColor="@color/text_white_100"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/heure_lieu_evenement"
                                    android:textColor="@color/text_white_40"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_pill_amber"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="@string/meeting_public_ouvert"
                                    android:textColor="@color/accent_amber"
                                    android:textSize="10sp"
                                    android:fontFamily="sans-serif-medium" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- DERNIÈRES ACTUALITÉS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/titre_dernieres_actualites"
                            android:textColor="@color/text_white_50"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/btnVoirActualites"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_tout_voir"
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowActualite1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgActualite1"
                            android:layout_width="80dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:background="@color/bg_deep"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/tvCategorieActu1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/blue_bg_20"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="@string/categorie_assemblee"
                                android:textColor="@color/info_blue"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:id="@+id/tvTitreActu1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/titre_actu1"
                                android:textColor="@color/text_white_100"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvDateActu1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/date_actu1"
                                android:textColor="@color/text_white_30"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowActualite2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgActualite2"
                            android:layout_width="80dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:background="@color/bg_deep"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/tvCategorieActu2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/green_bg_20"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="@string/categorie_terrain"
                                android:textColor="@color/success_green"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:id="@+id/tvTitreActu2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/titre_actu2"
                                android:textColor="@color/text_white_100"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvDateActu2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/date_actu2"
                                android:textColor="@color/text_white_30"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- RÉALISATIONS PHARES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/titre_realisations_phares"
                            android:textColor="@color/text_white_50"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/btnVoirRealisations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_tout_voir"
                            android:textColor="@color/accent_amber"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPhares"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="6dp"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_realisation_phare" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_bg"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <!-- BADGE VOTE — flottant au-dessus de tout -->
    <LinearLayout
        android:id="@+id/includeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_badge_vote_circle"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_votez"
                android:textColor="@color/on_amber"
                android:textSize="8sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvNumeroBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/numero_vote_valeur"
                android:textColor="@color/on_amber"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/badge_campagne"
            android:textColor="@color/accent_amber"
            android:textSize="8sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1" />

    </LinearLayout>

</FrameLayout>