<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <include layout="@layout/flag_strip" />

    <LinearLayout
        android:id="@+id/headerDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRetour"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_white_10"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_bg">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/retour"
                app:tint="@color/text_white_80" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/titre_ecran_detail_realisation"
            android:textColor="@color/text_white_100"
            android:textSize="18sp"
            android:fontFamily="@font/playfair_display"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_white_08"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/card_bg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <ImageView
                        android:id="@+id/imgDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/bg_deep"
                        android:contentDescription="@null" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gradient_hero" />

                    <TextView
                        android:id="@+id/tvSecteurDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/text_white_100"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-black"
                        tools:text="ÉDUCATION" />

                    <TextView
                        android:id="@+id/tvStatutDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-black"
                        tools:text="✓ Complété" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTitreDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_white_100"
                android:textSize="19sp"
                android:fontFamily="@font/playfair_display"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                tools:text="Réhabilitation de l'école de Kavimvira" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLieuDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_white_40"
                    android:textSize="12sp"
                    tools:text="📍 Kavimvira, Uvira" />

                <TextView
                    android:id="@+id/tvAnneeDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_amber"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    tools:text="2025" />

            </LinearLayout>

            <!-- Chiffres clés -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/blocBeneficiaires"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_beneficiaires_detail"
                        android:textColor="@color/text_white_30"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvBeneficiairesDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_white_100"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="600 élèves" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blocFinancement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_financement_detail"
                        android:textColor="@color/text_white_30"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvFinancementDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_white_100"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Fonds constit." />

                </LinearLayout>

            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_description_detail"
                    android:textColor="@color/text_white_100"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDescriptionDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white_50"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="Reconstruction de 6 salles de classe et fourniture de bancs pupitres." />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPartager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/accent_amber">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="13dp"
                    android:text="@string/action_partager_realisation"
                    android:textColor="@color/on_amber"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-black" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>